enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  password      String?
  role          Role       @default(MEMBER)
  status        UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  ideas    Idea[]
  votes    Vote[]
  comments Comment[]
  payments Payment[]

  @@map("users")
}
